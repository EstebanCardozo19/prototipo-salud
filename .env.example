# No subir el archivo .env real. Genere claves distintas y guárdelas en un
# gestor de secretos en producción.
POSTGRES_USER=salud_user
POSTGRES_PASSWORD=REEMPLACE_CON_UN_SECRETO
POSTGRES_DB=salud_db
DATABASE_URL=postgresql+psycopg2://salud_user:REEMPLACE_CON_UN_SECRETO@localhost:5433/salud_db
SAI_API_KEY=
JWT_SECRET_KEY=REEMPLACE_CON_UN_SECRETO_ALEATORIO
# Python: from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())
DATA_ENCRYPTION_KEY=REEMPLACE_CON_CLAVE_FERNET_VALIDA
# Python: import secrets; print(secrets.token_urlsafe(48))
EMAIL_LOOKUP_KEY=REEMPLACE_CON_SECRETO_ALEATORIO_DE_32_CARACTERES_O_MAS
# Web Push: genere un par VAPID y conserve la clave privada exclusivamente como secreto.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_CLAIMS_SUB=mailto:soporte@ejemplo.com